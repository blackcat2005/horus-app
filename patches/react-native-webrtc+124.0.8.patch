@@ -21,6 +21,39 @@ public class VideoEffectProcessor implements VideoProcessor {
         this.videoFrameProcessors = processors;
     }
 
+    /**
+     * horus-app patch: when true, processors receive the raw captured frame and the source's
+     * adaptation (downscale/drop chosen by the WebRTC encoder) is applied afterwards, only to the
+     * frame handed to the WebRTC sink. False keeps the stock behaviour (processors see the
+     * adapted frame). Toggled at runtime by modules/webrtc-recorder.
+     */
+    public static volatile boolean processRawFrames = false;
+
+    @Override
+    public void onFrameCaptured(VideoFrame frame, VideoProcessor.FrameAdaptationParameters parameters) {
+        if (!processRawFrames) {
+            VideoProcessor.super.onFrameCaptured(frame, parameters);
+            return;
+        }
+        frame.retain();
+        VideoFrame outputFrame = frame;
+        for (VideoFrameProcessor processor : this.videoFrameProcessors) {
+            outputFrame = processor.process(outputFrame, textureHelper);
+            if (outputFrame == null) {
+                outputFrame = frame;
+                frame.retain();
+                break;
+            }
+        }
+        VideoFrame adaptedFrame = VideoProcessor.applyFrameAdaptationParameters(outputFrame, parameters);
+        if (adaptedFrame != null) {
+            mSink.onFrame(adaptedFrame);
+            adaptedFrame.release();
+        }
+        outputFrame.release();
+        frame.release();
+    }
+
     @Override
     public void onCapturerStarted(boolean success) {}
 
